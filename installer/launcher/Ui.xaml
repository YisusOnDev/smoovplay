                </Canvas>
              </Viewbox>
            </Grid>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="SmoovPlay" FontFamily="{StaticResource Display}" FontSize="18" FontWeight="SemiBold" TextOptions.TextFormattingMode="Ideal"/>
              <TextBlock x:Name="RailVersion" Text="v0.2.0" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="1,1,0,0"/>
              <!-- asks GitHub now (UpdateCheck.Now in Updater.cs); RailUpdate takes its place once there's a newer release -->
              <Button x:Name="RailCheck" Content="Check for updates" Visibility="Collapsed" Cursor="Hand" HorizontalAlignment="Left" Margin="1,2,0,0"
                      ToolTip="Asks GitHub for a newer SmoovPlay now (it also checks by itself when it opens)." AutomationProperties.Name="Check for updates">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="t" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontSize="11"
                               Foreground="{StaticResource Muted}"/>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="TextDecorations" Value="Underline"/></Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="t" Property="TextDecorations" Value="Underline"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
              <!-- shown when GitHub has a newer release (UpdateCheck in Updater.cs) -->
              <Button x:Name="RailUpdate" Visibility="Collapsed" Cursor="Hand" HorizontalAlignment="Left" Margin="1,3,0,0">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="t" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontSize="11.5"
                               FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="TextDecorations" Value="Underline"/></Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="t" Property="TextDecorations" Value="Underline"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </StackPanel>
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" x:Name="RailFooter" Margin="4,0,0,0">
            <TextBlock x:Name="RailFooterTitle" Text="Free and open source" FontSize="12" Foreground="{StaticResource Text2}"/>
            <TextBlock x:Name="RailFooterText" Text="MIT licence. Not affiliated with Sony, NVIDIA or AMD." FontSize="11.5"
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="16"/>
          </StackPanel>

          <Grid>
            <StackPanel x:Name="Stepper"/>
            <StackPanel x:Name="Nav" Visibility="Collapsed">
              <RadioButton x:Name="NavPlay" Style="{StaticResource Nav}" Tag="&#xE768;" Content="Play"/>
              <RadioButton x:Name="NavGuide" Style="{StaticResource Nav}" Tag="&#xE7FC;" Content="Connect your PS5"/>
              <RadioButton x:Name="NavCheck" Style="{StaticResource Nav}" Tag="&#xE9D9;" Content="PC check"/>
              <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Tag="&#xE713;" Content="Settings"/>
              <RadioButton x:Name="NavHelp" Style="{StaticResource Nav}" Tag="&#xE897;" Content="Help"/>
            </StackPanel>
          </Grid>
        </DockPanel>
      </Grid>

      <!-- ============================================================ pages -->
      <Grid Grid.Column="1" x:Name="Content">
        <Grid.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
            <GradientStop Color="#11141A" Offset="0"/>
            <GradientStop Color="#0E1014" Offset="1"/>
          </LinearGradientBrush>
        </Grid.Background>
        <Grid x:Name="Pages" Margin="40,34,40,30">

          <!-- ======================== PC check -->
          <Grid x:Name="PageCheck" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock x:Name="CheckOverline" Style="{StaticResource Overline}" Text="STEP 1 OF 3  ·  PC CHECK"/>
              <TextBlock x:Name="CheckTitle" Style="{StaticResource H1}" Text="Let's check your PC"/>
              <TextBlock x:Name="CheckSub" Style="{StaticResource Sub}" Text="SmoovPlay is made for NVIDIA RTX graphics cards; AMD and Intel cards work as an Experimental option. Anything missing can be fixed right here."/>
            </StackPanel>
            <UniformGrid x:Name="CheckCards" Grid.Row="1" Columns="2" Margin="-5,16,-5,0" VerticalAlignment="Top"/>
            <Grid Grid.Row="2" Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="30" Height="30">
                  <Ellipse x:Name="CheckSummaryDot" Fill="#22FFB02E"/>
                  <TextBlock x:Name="CheckSummaryIcon" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Accent}" Text="&#xE9D9;"/>
                </Grid>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="300">
                  <TextBlock x:Name="CheckSummary" FontSize="14" FontWeight="SemiBold" Text="Checking your PC..." TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="CheckSummaryDetail" FontSize="12" Foreground="{StaticResource Text2}" Text="" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnCheckAnyway" Style="{StaticResource Ghost}" Content="Continue anyway" Margin="0,0,6,0" Visibility="Collapsed"/>
                <Button x:Name="BtnRecheck" Style="{StaticResource Secondary}" Margin="0,0,10,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE72C;"/>
                    <TextBlock Text="Check again" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button x:Name="BtnCheckNext" Style="{StaticResource Primary}" IsEnabled="False">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="BtnCheckNextText" Text="Continue" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE72A;" Margin="10,1,0,0"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Grid>

          <!-- ======================== folder -->
          <Grid x:Name="PageLocation" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource Overline}" Text="STEP 2 OF 3  ·  LOCATION"/>
              <TextBlock Style="{StaticResource H1}" Text="Where should SmoovPlay go?"/>
              <TextBlock Style="{StaticResource Sub}" Text="It takes about 12 GB, mostly PyTorch and TensorRT. No admin rights needed, and your settings stay put when you update."/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" Margin="0,22,-14,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
              <ScrollViewer.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="Black" Offset="0"/>
                  <GradientStop Color="Black" Offset="0.9"/>
                  <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
              </ScrollViewer.OpacityMask>
            <StackPanel Margin="0,0,14,0">
              <Border Style="{StaticResource Card}" Padding="18">
                <StackPanel>
                  <TextBlock Text="Install folder" FontSize="12" Foreground="{StaticResource Muted}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DirBox" Style="{StaticResource Field}"/>
                    <Button x:Name="BtnBrowse" Grid.Column="1" Style="{StaticResource Secondary}" Margin="10,0,0,0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xED25;"/>
                        <TextBlock Text="Browse" Margin="8,0,0,0" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </Grid>
                  <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Text2}" Text="&#xEDA2;"/>
                      <TextBlock x:Name="DriveName" Margin="8,0,0,0" FontWeight="SemiBold" Text="C:"/>
                      <TextBlock x:Name="DriveFree" Margin="8,0,0,0" Foreground="{StaticResource Text2}" Text=""/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <Ellipse Width="8" Height="8" Fill="#3A4250" VerticalAlignment="Center"/>
                      <TextBlock Text="Used" FontSize="12" Foreground="{StaticResource Muted}" Margin="6,0,14,0"/>
                      <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGrad}" VerticalAlignment="Center"/>
                      <TextBlock Text="SmoovPlay" FontSize="12" Foreground="{StaticResource Muted}" Margin="6,0,0,0"/>
                    </StackPanel>
                  </Grid>
                  <Grid x:Name="DriveBar" Height="10" Margin="0,10,0,0" ClipToBounds="True">
                    <Border CornerRadius="5" Background="#20252E"/>
                    <StackPanel Orientation="Horizontal">
                      <Border x:Name="DriveUsed" Width="0" Background="#3A4250" CornerRadius="5,0,0,5"/>
                      <Border x:Name="DriveNeed" Width="0" Background="{StaticResource AccentGradH}" CornerRadius="0,5,5,0" Margin="2,0,0,0"/>
                    </StackPanel>
                  </Grid>
                  <Border x:Name="DirProblem" Margin="0,14,0,0" CornerRadius="9" Background="#1FFF6464" BorderBrush="#40FF6464" BorderThickness="1" Padding="12,10" Visibility="Collapsed">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="DirProblemIcon" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource Bad}" Text="&#xE7BA;" VerticalAlignment="Top" Margin="0,1,10,0"/>
                      <TextBlock x:Name="DirProblemText" Grid.Column="1" Style="{StaticResource Small}" Foreground="{StaticResource Text}"/>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="BtnShortPath" Style="{StaticResource Pill}" Content="Use a shorter path" Visibility="Collapsed"/>
                        <Button x:Name="BtnLongPaths" Style="{StaticResource Pill}" Content="Turn on long paths" Margin="6,0,0,0" Visibility="Collapsed"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <TextBlock x:Name="DirExisting" Style="{StaticResource Small}" Margin="0,12,0,0" Foreground="{StaticResource Good}" Visibility="Collapsed"
                             Text="SmoovPlay is already installed here. Setup updates it in place."/>
                  <CheckBox x:Name="ToggleDesktop" Style="{StaticResource Switch}" Content="Add a desktop shortcut" IsChecked="True" Margin="0,18,0,0"/>
                </StackPanel>
              </Border>

              <TextBlock Text="WHAT SETUP DOWNLOADS" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="2,22,0,10"/>
              <UniformGrid Columns="2" Margin="-5,0">
                <Border Style="{StaticResource Card}" Margin="5" Padding="14,12">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Foreground="{StaticResource Accent}" Text="&#xE943;" Width="22"/>
                    <StackPanel Margin="10,0,0,0">
                      <TextBlock Text="Python 3.12" FontWeight="SemiBold"/>
                      <TextBlock Text="python.org  ·  a private copy, just for SmoovPlay" FontSize="12" Foreground="{StaticResource Text2}"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5" Padding="14,12">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Foreground="{StaticResource Accent}" Text="&#xE945;" Width="22"/>
                    <StackPanel Margin="10,0,0,0">
                      <TextBlock Text="PyTorch with CUDA" FontWeight="SemiBold"/>
                      <TextBlock Text="download.pytorch.org  ·  runs the AI model" FontSize="12" Foreground="{StaticResource Text2}"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5" Padding="14,12">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Foreground="{StaticResource Accent}" Text="&#xE950;" Width="22"/>
                    <StackPanel Margin="10,0,0,0">
                      <TextBlock Text="NVIDIA TensorRT" FontWeight="SemiBold"/>
                      <TextBlock Text="pypi.nvidia.com  ·  makes it about 12% faster" FontSize="12" Foreground="{StaticResource Text2}"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5" Padding="14,12">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Foreground="{StaticResource Accent}" Text="&#xE8F1;" Width="22"/>
                    <StackPanel Margin="10,0,0,0">
                      <TextBlock Text="PyAV, OpenCV, NumPy, ..." FontWeight="SemiBold"/>
                      <TextBlock Text="pypi.org  ·  video decoding and the window" FontSize="12" Foreground="{StaticResource Text2}"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </UniformGrid>
              <TextBlock Style="{StaticResource Small}" Margin="2,10,0,0" Foreground="{StaticResource Muted}"
                         Text="About 5 GB in all, straight from each project, each under its own licence. 10 to 20 minutes on a fast connection."/>
            </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2" Margin="0,14,0,0">
              <Button x:Name="BtnLocBack" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Height="44">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE72B;"/>
                  <TextBlock Text="Back" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="BtnInstall" Style="{StaticResource Primary}" HorizontalAlignment="Right" MinWidth="150">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE896;"/>
                  <TextBlock x:Name="BtnInstallText" Text="Install" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Grid>
          </Grid>

          <!-- ======================== installing -->
          <Grid x:Name="PageInstall" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock x:Name="InstallOverline" Style="{StaticResource Overline}" Text="STEP 3 OF 3  ·  INSTALLING"/>
              <TextBlock x:Name="InstallTitle" Style="{StaticResource H1}" Text="Setting things up"/>
              <TextBlock x:Name="InstallSub" Style="{StaticResource Sub}" Text="You can keep using your PC. Closing this window pauses setup; running it again picks up where it stopped."/>
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,24,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                  <TextBlock x:Name="InstallPercent" Text="0" FontFamily="{StaticResource Display}" FontSize="46" FontWeight="SemiBold" TextOptions.TextFormattingMode="Ideal"/>
                  <TextBlock Text="%" FontFamily="{StaticResource Display}" FontSize="24" Foreground="{StaticResource Text2}" Margin="3,0,0,9" VerticalAlignment="Bottom" TextOptions.TextFormattingMode="Ideal"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,10">
                  <TextBlock x:Name="InstallSpeed" HorizontalAlignment="Right" FontSize="13" Foreground="{StaticResource Text2}" Text=""/>
                </StackPanel>
              </Grid>
              <Grid x:Name="BarTrack" Grid.Row="1" Height="10" Margin="0,4,0,0">
                <Border CornerRadius="5" Background="#1E232B"/>
                <Border x:Name="BarFill" CornerRadius="5" Background="{StaticResource AccentGradH}" HorizontalAlignment="Left" Width="0" ClipToBounds="True">
                  <Canvas>
                    <Rectangle x:Name="BarShimmer" Width="160" Height="10">
                      <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                          <GradientStop Color="#00FFFFFF" Offset="0"/>
                          <GradientStop Color="#66FFFFFF" Offset="0.5"/>
                          <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                      </Rectangle.Fill>
                    </Rectangle>
                  </Canvas>
                </Border>
                <Border x:Name="BarGlow" CornerRadius="5" Background="{StaticResource AccentGradH}" HorizontalAlignment="Left" Width="0" Opacity="0.6" IsHitTestVisible="False">
                  <Border.Effect><BlurEffect Radius="12"/></Border.Effect>
                </Border>
              </Grid>
            </Grid>
            <Grid Grid.Row="2" Margin="0,22,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="250"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Style="{StaticResource Card}" Padding="18,14">
                <StackPanel x:Name="InstallSteps"/>
              </Border>
              <!-- while you wait: what to do on the PS5 -->
              <Border x:Name="TipCard" Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1E1B17" Offset="0"/>
                    <GradientStop Color="#161A21" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Accent}" Text="&#xEA80;"/>
                    <TextBlock Text="WHILE YOU WAIT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel x:Name="TipBody">
                    <TextBlock x:Name="TipTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0" Text=""/>
                    <TextBlock x:Name="TipText" Style="{StaticResource Small}" Margin="0,6,0,0" Text=""/>
                  </StackPanel>
                  <StackPanel x:Name="TipDots" Orientation="Horizontal" Margin="0,14,0,0"/>
                </StackPanel>
              </Border>
              <DockPanel Grid.Row="1" Grid.ColumnSpan="3" LastChildFill="True">
              <Border x:Name="ErrorCard" DockPanel.Dock="Top" Margin="0,14,0,0" CornerRadius="12" Background="#1AFF6464" BorderBrush="#4DFF6464"
                      BorderThickness="1" Padding="16,12" Visibility="Collapsed">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource Bad}" Text="&#xE7BA;" VerticalAlignment="Top" Margin="0,2,12,0"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock x:Name="ErrorTitle" FontWeight="SemiBold" FontSize="14" Text="Setup stopped"/>
                    <TextBlock x:Name="ErrorText" Style="{StaticResource Small}" Foreground="{StaticResource Text}" Margin="0,4,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Grid x:Name="InstallLogHost" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ToggleButton x:Name="BtnInstallDetails" Style="{StaticResource Disclosure}" Content="Show details" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <TextBox x:Name="InstallLog" Grid.Row="1" Style="{StaticResource LogBox}" Margin="0,6,0,0" Visibility="Collapsed"/>
              </Grid>
              </DockPanel>
            </Grid>
            <Grid Grid.Row="3" Margin="0,14,0,0">
              <Button x:Name="BtnCopyLog" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Height="44" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE8C8;"/>
                  <TextBlock Text="Copy diagnostics" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Style="{StaticResource Secondary}" Content="Cancel" MinWidth="110"/>
                <Button x:Name="BtnRetry" Style="{StaticResource Primary}" Margin="10,0,0,0" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE72C;"/>
                    <TextBlock Text="Retry" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Grid>

          <!-- ======================== done -->
          <Grid x:Name="PageDone" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,30">
              <Grid Width="132" Height="132" HorizontalAlignment="Center">
                <Ellipse x:Name="DoneGlow" Fill="#3DDC8E" Opacity="0" Margin="10">
                  <Ellipse.Effect><BlurEffect Radius="40"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Stroke="#1F3A2D" StrokeThickness="5" Margin="8"/>
                <Ellipse x:Name="DoneRing" Stroke="#3DDC8E" StrokeThickness="5" Margin="8" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                </Ellipse>
                <Path x:Name="DoneCheck" Data="M42,68 L59,84 L92,50" Stroke="#3DDC8E" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                <Canvas x:Name="DoneBurst" IsHitTestVisible="False"/>
              </Grid>
              <TextBlock x:Name="DoneTitle" Style="{StaticResource H1}" FontSize="30" HorizontalAlignment="Center" Margin="0,26,0,0" Text="SmoovPlay is ready"/>
              <TextBlock x:Name="DoneSub" Style="{StaticResource Sub}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="460"
                         Text="It's in your Start menu too. Next, SmoovPlay walks you through connecting your PS5. It takes about five minutes, once."/>
              <Button x:Name="BtnOpen" Style="{StaticResource Primary}" HorizontalAlignment="Center" Margin="0,30,0,0" MinWidth="200" Height="48" FontSize="15">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="BtnOpenText" Text="Open SmoovPlay" VerticalAlignment="Center"/>
                  <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE72A;" Margin="10,1,0,0"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <!-- ======================== play -->
          <Grid x:Name="PagePlay" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel VerticalAlignment="Center" Margin="0,0,0,10">
              <Grid x:Name="PlayDiscArea" HorizontalAlignment="Center" Width="214" Height="214">
                <Ellipse x:Name="PlayGlow" Width="170" Height="170" Fill="{StaticResource AccentGrad}" Opacity="0.35">
                  <Ellipse.Effect><BlurEffect Radius="48"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse x:Name="PlaySpin" Width="196" Height="196" StrokeThickness="3" StrokeDashCap="Round" StrokeDashArray="14 50" Opacity="0" RenderTransformOrigin="0.5,0.5"
                         Stroke="{StaticResource AccentGrad}">
                  <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="196" Height="196" Stroke="#1AFFFFFF" StrokeThickness="1"/>
                <Button x:Name="PlayButton" Style="{StaticResource Bare}" Width="164" Height="164" AutomationProperties.Name="Play">
                  <Grid>
                    <Ellipse x:Name="PlayDisc" Fill="{StaticResource AccentGrad}"/>
                    <Ellipse Margin="1">
                      <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                          <GradientStop Color="#40FFFFFF" Offset="0"/>
                          <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                        </LinearGradientBrush>
                      </Ellipse.Fill>
                    </Ellipse>
                    <Path x:Name="PlayTri" Data="M0,0 L40,24 L0,48 Z" Fill="#1A1206" Stroke="#1A1206" StrokeThickness="7" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Rectangle x:Name="PlayStop" Width="40" Height="40" RadiusX="8" RadiusY="8" Fill="#1A1206" Visibility="Collapsed"/>
                  </Grid>
                </Button>
                <Border x:Name="PlayLive" HorizontalAlignment="Center" VerticalAlignment="Bottom" CornerRadius="11" Background="#1E2A24" BorderBrush="#3DDC8E"
                        BorderThickness="1" Padding="10,3" Margin="0,0,0,-4" Visibility="Hidden">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="PlayLiveDot" Width="7" Height="7" Fill="{StaticResource Good}" VerticalAlignment="Center"/>
                    <TextBlock Text="LIVE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Good}" Margin="6,0,0,0"/>
                  </StackPanel>
                </Border>
              </Grid>
              <TextBlock x:Name="PlayTitle" Style="{StaticResource H1}" FontSize="26" HorizontalAlignment="Center" Margin="0,18,0,0" Text="Ready when you are"/>
              <TextBlock x:Name="PlaySub" Style="{StaticResource Sub}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="500"
                         Text="Press Play. chiaki-ng opens: connect to your PS5 there, and the smooth video appears in its own window."/>
              <!-- Where the video comes from (Sources in Core.cs); only shown when more than one source is offered. -->
              <WrapPanel x:Name="PlaySources" HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed"/>
              <!-- Playing from a capture card: which card and which sound (Ui.BuildDevices). -->
              <WrapPanel x:Name="PlayDevices" HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed"/>
              <!-- Playing from an app's window: SmoovPlay's keys, which work from anywhere, and changing them (Ui.BuildKeys). -->
              <StackPanel x:Name="PlayKeys" HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed"/>
              <WrapPanel x:Name="PlayChips" HorizontalAlignment="Center" Margin="0,18,0,0"/>
              <Border x:Name="PlayNote" HorizontalAlignment="Center" MaxWidth="560" Margin="0,16,0,0" CornerRadius="10" Background="#1FFFC24B" BorderBrush="#40FFC24B"
                      BorderThickness="1" Padding="14,10" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Warn}" Text="&#xE7BA;" VerticalAlignment="Top" Margin="0,2,10,0"/>
                  <TextBlock x:Name="PlayNoteText" Style="{StaticResource Small}" Foreground="{StaticResource Text}" MaxWidth="500"/>
                </StackPanel>
              </Border>
              <!-- Test mode: a 60 fps game played as if it were 30 fps (Session.TestMode), then its report. -->
              <Button x:Name="BtnPlayTest" Style="{StaticResource Ghost}" HorizontalAlignment="Center" Margin="0,8,0,0"
                      ToolTip="Most PS5 games already run at 60 fps, so SmoovPlay has nothing to add. This plays one as if it were 30 fps, so you can see how your PC handles frame generation and how close the AI frames come to the real ones.">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE9D9;"/>
                  <TextBlock x:Name="BtnPlayTestText" Text="Test with a 60 fps game" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Border x:Name="PlayResults" Style="{StaticResource Card}" HorizontalAlignment="Center" Width="580" Margin="0,10,0,0" Padding="18,12,10,14" Visibility="Collapsed">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="TEST RESULTS" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-6,0,-6">
                      <Button x:Name="BtnResultsCopy" Style="{StaticResource Ghost}" Height="30" Padding="10,0" ToolTip="Copy the full report, to paste into a test report or a GitHub issue">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE8C8;"/>
                          <TextBlock Text="Copy results" FontSize="12.5" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                      <Button x:Name="BtnResultsOpen" Style="{StaticResource Ghost}" Height="30" Padding="10,0" Content="Full report" FontSize="12.5"/>
                      <Button x:Name="BtnResultsClose" Style="{StaticResource Ghost}" Height="30" Width="30" Padding="0" AutomationProperties.Name="Close the results" ToolTip="Close">
                        <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE8BB;"/>
                      </Button>
                    </StackPanel>
                  </Grid>
                  <TextBlock x:Name="ResultsVerdict" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,8,0"/>
                  <UniformGrid x:Name="ResultsTiles" Rows="1" Margin="-4,10,4,0"/>
                  <TextBlock x:Name="ResultsNote" Style="{StaticResource Small}" Foreground="{StaticResource Muted}" Margin="0,10,8,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="1">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid>
                <ToggleButton x:Name="BtnPlayDetails" Style="{StaticResource Disclosure}" Content="Show details" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="BtnPlayDiag" Style="{StaticResource Ghost}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE8C8;"/>
                      <TextBlock Text="Copy diagnostics" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="BtnPlayLogs" Style="{StaticResource Ghost}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xED25;"/>
                      <TextBlock Text="Logs" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
              <TextBox x:Name="PlayLog" Grid.Row="1" Style="{StaticResource LogBox}" Height="150" Margin="0,6,0,0" Visibility="Collapsed"/>
            </Grid>
          </Grid>

          <!-- ======================== PS5 guide -->
          <Grid x:Name="PageGuide" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="GuideOverline" Style="{StaticResource Overline}" Text="ONE-TIME SETUP  ·  ABOUT 5 MINUTES"/>
                <TextBlock x:Name="GuideTitle" Style="{StaticResource H1}" Text="Connect your PS5"/>
                <TextBlock x:Name="GuideSub" Style="{StaticResource Sub}" Text="SmoovPlay gets the picture from chiaki-ng, a free, unofficial Remote Play app that comes with it. Sony doesn't make or support it. Tick each step as you go; SmoovPlay remembers."/>
              </StackPanel>
              <Grid Grid.Column="1" Width="64" Height="64" Margin="20,30,0,0" VerticalAlignment="Top">
                <Ellipse Stroke="#232933" StrokeThickness="5"/>
                <Ellipse x:Name="GuideRing" Stroke="{StaticResource AccentGrad}" StrokeThickness="5" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                </Ellipse>
                <TextBlock x:Name="GuideCount" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" Text="0/7"/>
              </Grid>
            </Grid>
            <ScrollViewer Grid.Row="1" Margin="0,18,-14,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
              <ScrollViewer.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="Black" Offset="0"/>
                  <GradientStop Color="Black" Offset="0.9"/>
                  <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
              </ScrollViewer.OpacityMask>
              <StackPanel x:Name="GuideSteps" Margin="0,0,14,0"/>
            </ScrollViewer>
            <Grid Grid.Row="2" Margin="0,14,0,0">
              <Button x:Name="BtnGuideDocs" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Height="44">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE8A7;"/>
                  <TextBlock Text="chiaki-ng's full guide" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnGuideChiaki" Style="{StaticResource Secondary}" Margin="0,0,10,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE8A7;"/>
                    <TextBlock Text="Open chiaki-ng" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button x:Name="BtnGuidePlay" Style="{StaticResource Primary}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Go to Play" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE72A;" Margin="10,1,0,0"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Grid>

          <!-- ======================== settings (rows built by SettingsPage.cs from the pipeline's own list) -->
          <Grid x:Name="PageSettings" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource Overline}" Text="SETTINGS"/>
              <TextBlock Style="{StaticResource H1}" Text="Tune SmoovPlay"/>
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="SetLive" CornerRadius="10" Background="#1E2A24" BorderBrush="#3DDC8E" BorderThickness="1" Padding="8,2" Margin="0,1,10,0"
                        VerticalAlignment="Top" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource Good}" VerticalAlignment="Center"/>
                    <TextBlock Text="LIVE" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Good}" Margin="5,0,0,0"/>
                  </StackPanel>
                </Border>
                <TextBlock x:Name="SetStatus" Grid.Column="1" Style="{StaticResource Sub}" Margin="0"
                           Text="Saved for every session. While you play, changes reach the video straight away."/>
              </Grid>
            </StackPanel>
            <!-- restart-only settings changed while playing -->
            <Border x:Name="SetRestart" Grid.Row="1" Margin="0,14,0,0" CornerRadius="12" Background="#1AFFB02E" BorderBrush="#40FFB02E" BorderThickness="1"
                    Padding="16,10,10,10" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource Accent}" Text="&#xE72C;" Margin="0,0,12,0"/>
                <TextBlock x:Name="SetRestartText" Grid.Column="1" Style="{StaticResource Small}" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="BtnSetRestart" Grid.Column="2" Style="{StaticResource Primary}" Height="36" Padding="16,0" Content="Restart now"
                        ToolTip="The video pauses for a few seconds while the AI model restarts. The stream keeps going."/>
              </Grid>
            </Border>
            <ScrollViewer x:Name="SetScroll" Grid.Row="2" Margin="0,14,-14,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
              <ScrollViewer.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="Black" Offset="0"/>
                  <GradientStop Color="Black" Offset="0.93"/>
                  <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
              </ScrollViewer.OpacityMask>
              <StackPanel Margin="0,0,14,24">
                <!-- the big choices: frame rate, model, upscaler (SettingsPage.cs, specs with "quick") -->
                <StackPanel x:Name="SetQuick"/>
                <!-- Auto-detect (AutoDetect.cs): DetectBody shows the test's progress, then what it found and suggests -->
                <Border x:Name="DetectCard" Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,22">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Border Width="38" Height="38" CornerRadius="10" Background="#2A2214" VerticalAlignment="Top" Margin="0,1,14,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" FontSize="18" Foreground="{StaticResource Accent}"/>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Best settings for this PC" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Small}" Margin="0,4,0,0"
                                   Text="Auto-detect times the AI model on your graphics card, reads your display's refresh rate and checks what's installed, then suggests settings, with the reason for each. It takes about 10 seconds."/>
                      </StackPanel>
                      <Button x:Name="BtnDetect" Grid.Column="2" Style="{StaticResource Primary}" Height="36" Padding="16,0" VerticalAlignment="Top"
                              Content="Auto-detect" ToolTipService.ShowOnDisabled="True"/>
                    </Grid>
                    <StackPanel x:Name="DetectBody" Margin="52,14,0,0" Visibility="Collapsed"/>
                  </StackPanel>
                </Border>
                <!-- the other settings, in folding sections: one column, or two in a wide window -->
                <Grid x:Name="SetRows"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- ======================== help -->
          <Grid x:Name="PageHelp" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource Overline}" Text="HELP"/>
              <TextBlock Style="{StaticResource H1}" Text="Help and tools"/>
              <TextBlock Style="{StaticResource Sub}" Text="Something off? Copy diagnostics and paste them into your bug report. They leave out your Windows user name."/>
            </StackPanel>
            <UniformGrid Grid.Row="1" Columns="2" Margin="-5,16,-5,0">
              <Button x:Name="HelpDiag" Style="{StaticResource Tile}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid Width="36" Height="36" VerticalAlignment="Top"><Ellipse Fill="#22FFB02E"/><TextBlock Style="{StaticResource Icon}" Foreground="{StaticResource Accent}" FontSize="15" Text="&#xE8C8;"/></Grid>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="Copy diagnostics" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Style="{StaticResource Small}" Text="PC check, versions and the last log, ready to paste." Margin="0,3,0,0"/>
                  </StackPanel>
                </Grid>
              </Button>
              <Button x:Name="HelpLogs" Style="{StaticResource Tile}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid Width="36" Height="36" VerticalAlignment="Top"><Ellipse Fill="#22FFB02E"/><TextBlock Style="{StaticResource Icon}" Foreground="{StaticResource Accent}" FontSize="15" Text="&#xED25;"/></Grid>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="Open the logs folder" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Style="{StaticResource Small}" Text="One log per session and per setup run." Margin="0,3,0,0"/>
                  </StackPanel>
                </Grid>
              </Button>
              <Button x:Name="HelpRepair" Style="{StaticResource Tile}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid Width="36" Height="36" VerticalAlignment="Top"><Ellipse Fill="#22FFB02E"/><TextBlock Style="{StaticResource Icon}" Foreground="{StaticResource Accent}" FontSize="15" Text="&#xE90F;"/></Grid>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="Repair SmoovPlay" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Style="{StaticResource Small}" Text="Puts back anything missing, or downloads it all again." Margin="0,3,0,0"/>
                  </StackPanel>
                </Grid>
              </Button>
              <Button x:Name="HelpUninstall" Style="{StaticResource Tile}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid Width="36" Height="36" VerticalAlignment="Top"><Ellipse Fill="#1FFF6464"/><TextBlock Style="{StaticResource Icon}" Foreground="{StaticResource Bad}" FontSize="15" Text="&#xE74D;"/></Grid>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="Uninstall" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Style="{StaticResource Small}" Text="Removes SmoovPlay. Your settings are kept." Margin="0,3,0,0"/>
                  </StackPanel>
                </Grid>
              </Button>
            </UniformGrid>
            <StackPanel Grid.Row="2" Margin="0,10,0,0" VerticalAlignment="Top">
              <Border Style="{StaticResource Card}" Padding="18,14">
                <StackPanel>
                  <TextBlock Text="IN THE VIDEO WINDOW" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                  <WrapPanel x:Name="Keys" Margin="0,8,0,0"/>
                  <TextBlock Style="{StaticResource Small}" Margin="0,10,0,0" TextWrapping="Wrap"
                             Text="Playing from an app's window? The app keeps the keyboard, so these use Ctrl+Alt there: Ctrl+Alt+M menu, Ctrl+Alt+F fullscreen, Ctrl+Alt+Esc quit. The Play page lists them all and lets you change them."/>
                  <TextBlock Style="{StaticResource Small}" Margin="0,12,0,0" TextWrapping="Wrap"
                             ToolTip="Most PS5 games already run at 60 fps, so SmoovPlay has nothing to add. Test with a 60 fps game (or Simulate a 30 fps game in the M menu) plays one as if it were 30 fps, then reports how well your PC keeps up and how close the AI frames come to the real ones."
                             Text="Only 60 fps games? Test with a 60 fps game, on the Play page, plays one as if it were 30 fps."/>
                  <TextBlock Style="{StaticResource Small}" Margin="0,6,0,0" TextWrapping="Wrap"
                             ToolTip="NVIDIA Smooth Motion, AMD Fluid Motion Frames and Lossless Scaling also generate frames. Turned on for SmoovPlay's video window or for chiaki-ng, they'd make frames out of SmoovPlay's generated ones (more wobble) and add delay. Leave them off for both; your other games aren't affected."
                             Text="One frame generator at a time: leave Smooth Motion, AFMF and Lossless Scaling off for SmoovPlay and chiaki-ng."/>
                </StackPanel>
              </Border>
              <TextBlock Style="{StaticResource Small}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,12,0,0"
                         Text="chiaki-ng is an unofficial Remote Play app. SmoovPlay and chiaki-ng are independent projects, not made, supported or endorsed by Sony Interactive Entertainment. PlayStation and PS5 are its trademarks."/>
            </StackPanel>
            <Grid Grid.Row="3" Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="HelpVersion" Style="{StaticResource Small}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="2,0,12,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="HelpFeedback" Style="{StaticResource Ghost}" Content="Send feedback"
                        ToolTip="Copies diagnostics and opens a GitHub page for your report. Nothing is sent until you post it."/>
                <Button x:Name="HelpLicences" Style="{StaticResource Ghost}" Content="Licences"/>
                <Button x:Name="HelpSource" Style="{StaticResource Ghost}" Content="chiaki-ng source"/>
                <Button x:Name="HelpDocs" Style="{StaticResource Ghost}" Content="chiaki-ng help"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>

        <!-- window buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0">
          <Button x:Name="BtnMin" Style="{StaticResource Chrome}" Content="&#xE921;" ToolTip="Minimise"/>
          <Button x:Name="BtnClose" Style="{StaticResource Chrome}" Content="&#xE8BB;" Tag="close" ToolTip="Close"/>
        </StackPanel>

        <!-- toast -->
        <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,86" CornerRadius="20" Background="#262C36"
                BorderBrush="#38404E" BorderThickness="1" Padding="16,9" Opacity="0" IsHitTestVisible="False">
          <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5"/></Border.Effect>
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="ToastIcon" Style="{StaticResource Icon}" Foreground="{StaticResource Good}" FontSize="13" Text="&#xE73E;"/>
            <TextBlock x:Name="ToastText" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
            <!-- an offer that goes with the message ("Use it now"); only shown when there is one -->
            <Button x:Name="ToastAction" Style="{StaticResource Pill}" Margin="14,0,0,0" Visibility="Collapsed" AutomationProperties.AutomationId="ToastAction"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ============================================================ dialog -->
      <Grid x:Name="Dialog" Grid.ColumnSpan="2" Visibility="Collapsed">
        <Border x:Name="DialogScrim" CornerRadius="16" Background="#C0080A0D"/>
        <Border x:Name="DialogCard" Width="452" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="16" Background="#1A1F27"
                BorderBrush="#2E3542" BorderThickness="1" Padding="26,24" RenderTransformOrigin="0.5,0.5">
          <StackPanel>
            <Grid Width="44" Height="44" HorizontalAlignment="Left">
              <Ellipse x:Name="DialogIconBg" Fill="#26FFB02E"/>
              <TextBlock x:Name="DialogIcon" Style="{StaticResource Icon}" Foreground="{StaticResource Accent}" FontSize="19" Text="&#xE897;"/>
            </Grid>
            <TextBlock x:Name="DialogTitle" FontFamily="{StaticResource Display}" FontSize="19" FontWeight="SemiBold" Margin="0,16,0,0" TextWrapping="Wrap" TextOptions.TextFormattingMode="Ideal"/>
            <TextBlock x:Name="DialogText" Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20" FontSize="13.5"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
              <Button x:Name="DialogBtn3" Style="{StaticResource Ghost}" Height="44" Margin="0,0,6,0"/>
              <Button x:Name="DialogBtn2" Style="{StaticResource Secondary}" Margin="0,0,10,0"/>
              <Button x:Name="DialogBtn1" Style="{StaticResource Primary}"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
